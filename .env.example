# Секреты не коммитятся. Скопируйте в `.env` и задайте свои значения.
POSTGRES_PASSWORD=replace-me
CS_REGISTRY_APP_PASSWORD=replace-me

# Прикладная роль: SELECT/INSERT на audit_events, без UPDATE/DELETE
DATABASE_URL=postgres://cs_registry_app:replace-me@127.0.0.1:5432/cs_registry

# Владелец схемы: миграции и проверка триггера поверх прав роли
DATABASE_ADMIN_URL=postgres://postgres:replace-me@127.0.0.1:5432/cs_registry

# Отдельная база для интеграционных тестов и e2e. Не должна совпадать с DATABASE_URL:
# иначе тесты откажутся запускаться. Создаётся `pnpm ci:local` / scripts/ci-local.sh.
TEST_DATABASE_URL=postgres://cs_registry_app:replace-me@127.0.0.1:5432/cs_registry_test
TEST_DATABASE_ADMIN_URL=postgres://postgres:replace-me@127.0.0.1:5432/cs_registry_test

# Файл контрольной точки хеш-цепочки для `pnpm audit:verify` (URS-044 / URS-100).
# Вне доступа прикладной роли. Необязателен для ручного прогона.
# AUDIT_CHECKPOINT_FILE=/var/lib/cs-registry/audit-checkpoint.json

# Необязательно. Переопределяет версию из package.json только для отладки
# и тестовых стендов. Базовая версия, которую отдаёт /api/health, берётся
# из поля version в package.json.
# APP_VERSION=debug-override

# Срок жизни сессии, минуты, по ролям (URS-062).
# admin — 30 минут, editor / viewer / auditor — 10 минут.
SESSION_MINUTES_ADMIN=30
SESSION_MINUTES_DEFAULT=10
# Secure-флаг cookie: true в production, false для http://127.0.0.1
# SESSION_SECURE=false

# Только для e2e (Playwright), на приложение не влияют.
# Пусто / не задано — системный Google Chrome. Без Chrome:
# pnpm exec playwright install chromium (e2e возьмёт его сам, либо E2E_BROWSER_CHANNEL=chromium).
# E2E_BROWSER_CHANNEL=chrome
# Диагностический скриншот вёрстки списка; ошибка записи тест не валит.
# E2E_SCREENSHOT_DIR=test-results/screenshots
